pvalue_fun <- function(x) {
  ifelse(
    is.na(x),
    NA_character_,
    ifelse(
      x < 0.0001,
      "<0.0001",
      format(signif(x, 2), trim = TRUE, scientific = FALSE)
    )
  )
}

