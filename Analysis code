proc format;
value TRA
0 = "TFA"
1 = "TRA";
value TFA
0 = "TRA"
1 = "TFA";
value Primary_Outcome
0 = "否,n(%)"
1 = "是,n(%)"
2 = "率差及其97.8% CI"
2.1 = "TAR χ2值 in glm"
2.2 = "TAR P值 in glm"
3 = "P值"
-99="N(Missing)";
/* value SEX*/
  /*   0 = "女"*/
  /*   1 = "男";*/
  /* value XZ*/
  /*   0 = "否"*/
  /*   1 = "是";*/
  /* value BBC*/
  /*   0 = "左侧"*/
  /*   1 = "右侧";*/
  run;


/*Noninferiority was assessed on the risk difference scale.*/
  /*Because the outcome represented an adverse event, the noninferiority test was conducted on the complement (event-free rate), such that a noninferiority margin of ?2% for the event-free rate corresponds to a margin of +2% for the event rate.*/
  /*A one-sided Farrington–Manning test was used to obtain the noninferiority p value.*/
  
  /*FAS-不填补结局*/
  PROC MEANS DATA=DATA1 N NMISS;
CLASS TFA;
VAR Primary_Outcome2;
format TFA TFA.;
ods output Summary=Summary;
RUN;

proc freq data = DATA1;
tables TFA*Primary_Outcome2 /nopercent nocol chisq ;
format TFA TFA.;
ods output CrossTabFreqs=CrossTabFreqs;
run ;

/*置信区间-加上中心volume 如果求单因素的见 主要疗效指标分析*/
  
  proc genmod data=DATA1 descending;
class TRA(ref='0')
center_volume(ref='1') / param=ref;

model Primary_Outcome2 = TRA center_volume
/ dist=binomial link=identity;

/* 双侧97.8% Wald置信区间 */
  estimate "Adjusted RD: Trial-Control" TRA 1
/ alpha=0.022;

ods output Estimates=AdjRD;
run;


data Adj_Noninf;
set AdjRD;
length NI_Conclusion $40;
Margin=0.02;
/*
  GENMOD的Estimates表通常使用以下变量名。
建议通过PROC CONTENTS确认。
*/
  RD_event=MeanEstimate;
SE=StdErr;
/* 双侧97.8% Wald CI */
  LowerCL=MeanLowerCL;
UpperCL=MeanUpperCL;
/*
  Primary_Outcome2=1表示不良复合终点；
RD=试验组事件率－对照组事件率。

H0：RD_event >= 0.02
H1：RD_event <  0.02
*/
  Z_noninf=(RD_event-Margin)/SE;
P_noninf=probnorm(Z_noninf);

/*
  双侧97.8%CI对应单侧alpha=0.011。
以下两种判定完全一致：

1. P_noninf < 0.011
2. 双侧97.8%CI上限 < 0.02
*/
  if P_noninf<0.011 then
NI_Conclusion="达到非劣效";
else
  NI_Conclusion="未达到非劣效";

/* 普通双侧检验：H0为RD=0 */
  Z_equal=RD_event/SE;
P_twosided=2*(1-probnorm(abs(Z_equal)));

format RD_event LowerCL UpperCL Margin percentn12.2
SE 12.6
Z_noninf P_noninf
Z_equal P_twosided 12.4;
run;


