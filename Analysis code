  labeltext = tabel_text,
  mean = as.numeric(SubResult$OR),
  lower = as.numeric(SubResult$low),
  upper =  as.numeric(SubResult$high),
  zero=1,
  boxsize=0.4,
  graph.pos= 4,
  graphwidth = unit(.25,"npc"),
  xlab="Risk ratio (95% CI)",
  is.summary=c(T,F,F,T,F,F,T,F,F,T,F,F,
               T,F,F,T,F,F,T,F,F,T,F,F,T),#T=粗体
  txt_gp = fpTxtGp(
    label = gpar(cex = 1*0.3*2*1.5*0.9),
    ticks = gpar(cex = 1.1*0.3*2*1.5*0.9),
    xlab = gpar(cex = 1*0.3*2*1.5*0.9),
    title = gpar(cex = 2*0.3*2*1.5*0.9)
  ),
  lwd.zero = 1.5*0.3*2*1.2*2,
  lwd.ci = 1.5*0.3*2*1.2*2,
  lwd.xaxis = 1.5*0.3*2*1.2*2,
  lty.ci = 1,
  ci.vertices = FALSE,
  ci.vertices.height = 0.1,
  clip=c(0,3),
  lineheight=unit(6, 'mm'),
  line.margin=unit(6, 'mm'),
  colgap=unit(6, 'mm'),
  col=fpColors(zero = "black",
               box = 'black',
               lines = 'black'),
  xticks = c(0, 1,2,3),
  fn.ci_norm = "fpDrawCircleCI"
) %>%
  fp_add_header(
    var = c("", ""),
    `TRA` = c(
      "Transradial approach",
      "n patients with event/N (%)"
    ),
    `TFA` = c(
      "Transfemoral approach",
      "n patients with event/N (%)"
    ),
    `RR (95% CI)` = c(
      "RR (95% CI)",
      ""
    ),
    `P for interaction` = c(
      expression(bolditalic(P) ~ bold(" for interaction")),
      ""
    )
  ) %>%
  fp_add_lines(
    h_2 = gpar(
      lty = 1,
      columns = c(2, 3)
    ),
    h_3 = gpar(
      lty = 1
    )
  )
dev.off()
