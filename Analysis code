/*if volume>0 and volume<=10 then center_volume=1;*/
  /*else if volume>10 and volume<=50 then center_volume=2;*/
  /*else if volume>50 and volume<=100 then center_volume=3;*/
  /*else if volume>100 then center_volume=4;*/
  
  if volume=50 then center_volume=1;
else if volume=100 then center_volume=2;
