output_of_glm_sub_2 = function(fit = NULL){
  fit %>%
    broom::tidy(exp = TRUE, conf.int = TRUE) %>%
    mutate(OR = round(estimate, 2),
           low = round(conf.low,2),
           high = round(conf.high,2),
           ci = paste0(low,'-',high),
           ORvalue = paste0(OR, ' (', ci, ')'),
           p.value = ifelse(
             p.value < 0.0001,
             " < 0.001",
             signif(p.value, 2)
           )) %>% 
    filter(term != '(Intercept)') %>% 
    dplyr::select(term, ORvalue, OR, low, high, p.value) 
}

do_analysis <- function (data) {
  glm(Primary_Outcome ~ 组别, family = poisson(link = "log"), data = data) %>%
    output_of_glm_sub_2()
}

